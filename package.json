{
  "name": "vapor-talk",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "pnpm run build && tsc --noEmit",
    "test": "vitest run",
    "migrate": "wrangler d1 migrations apply vapor-talk-db --local",
    "migrate:remote": "wrangler d1 migrations apply vapor-talk-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/inertia": "^0.8.0",
    "@inertiajs/core": "^3.7.1",
    "@inertiajs/react": "^3.7.1",
    "hono": "^4.13.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.1",
    "@cloudflare/workers-types": "^5.20260925.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-ssr-components": "^0.8.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.140.0"
  }
}
