{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vapor-talk",
  "main": "./app/server.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // カスタムドメインではなくルート（プロキシ済み DNS レコード talk.hashrock.info が必要）
  "routes": [{ "pattern": "talk.hashrock.info/*", "zone_name": "hashrock.info" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vapor-talk-db",
      "database_id": "cb11fd1e-e188-493c-939f-624cfa1c847f"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  // 有効期限切れルームの掃除
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": {
    // Cloudflare Realtime SFU の App ID（トークンは secret の CALLS_APP_TOKEN）
    "CALLS_APP_ID": "18905d714068b027a6e9460e7cfd5960"
  }
}
